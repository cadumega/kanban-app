# ===========================================
# KANBAN CRM - Environment Variables
# ===========================================
# Copy this file to .env and configure your values
# NEVER commit .env to version control!

# ===========================================
# REQUIRED IN PRODUCTION
# ===========================================

# JWT Secret - MUST be a long, random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Master User Credentials - Required for initial admin setup
MASTER_EMAIL=admin@yourcompany.com
MASTER_PASSWORD=your-secure-master-password
MASTER_NAME=Administrator

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Token Expiration (default: 7d)
JWT_EXPIRES_IN=7d

# CORS - Allowed Origins (comma-separated)
# Example: https://app.yourcompany.com,https://www.yourcompany.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window
LOGIN_RATE_LIMIT_MAX=5            # Max login attempts per window

# Logging
LOG_LEVEL=info                    # debug, info, warn, error
LOGS_DIR=./logs                   # Directory for log files

# ===========================================
# DEVELOPMENT ONLY (remove in production)
# ===========================================
# NODE_ENV=development
# In development, default master credentials are used if not set:
# - Email: admin@localhost
# - Password: change-me-immediately
